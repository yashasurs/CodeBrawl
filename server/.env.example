# Server Configuration
PORT=8000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/codebrawl
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Secrets (Generate secure random strings for production)
ACCESS_TOKEN_SECRET=your_super_secure_access_token_secret_replace_in_production
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=your_super_secure_refresh_token_secret_replace_in_production
REFRESH_TOKEN_EXPIRY=30d

# Cloudinary Configuration (for avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
